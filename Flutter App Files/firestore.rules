rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerReference(userRef) {
      return request.auth != null
        && userRef == /databases/$(database)/documents/User/$(request.auth.uid);
    }

    function validProfile(data) {
      let fields = [
        'fullName', 'email', 'updatedAt', 'accountStatus', 'voicePersona',
        'speechRate', 'instructionFrequency', 'alertRepetitionCount',
        'vibrationEnabled'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.fullName is string
        && data.email is string
        && data.updatedAt is timestamp
        && data.accountStatus is string
        && data.voicePersona is string
        && data.speechRate is number
        && data.speechRate > 0
        && data.instructionFrequency is string
        && data.alertRepetitionCount is int
        && data.alertRepetitionCount >= 0
        && data.vibrationEnabled is bool;
    }

    function validProfileName(name) {
      return name is string && name.size() >= 2 && name.size() <= 20;
    }

    function validFavorite(data) {
      return data.keys().hasAll([
          'userRef', 'placeName', 'address', 'location', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userRef', 'placeName', 'address', 'location', 'createdAt'
        ])
        && data.placeName is string
        && data.address is string
        && data.location is latlng
        && data.createdAt is timestamp;
    }

    function validSession(data) {
      let endTime = data.get('endedAt', null);
      return data.keys().hasAll([
          'userRef', 'startLocation', 'destination', 'startedAt', 'status',
          'distance'
        ])
        && data.keys().hasOnly([
          'userRef', 'startLocation', 'destination', 'startedAt', 'endedAt',
          'status', 'distance'
        ])
        && data.startLocation is latlng
        && data.destination is latlng
        && data.startedAt is timestamp
        && (
          endTime == null
          || (endTime is timestamp && endTime >= data.startedAt)
        )
        && data.status is string
        && data.distance is number
        && data.distance >= 0;
    }

    match /User/{userId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId)
        && validProfile(request.resource.data)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.updatedAt == request.time;

      // Keep strict schema validation for full profile and preference updates.
      allow update: if isOwner(userId)
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'voicePersona', 'speechRate', 'instructionFrequency',
          'alertRepetitionCount', 'vibrationEnabled', 'updatedAt'
        ]);

      // Let an owner edit only their name on an older, incomplete profile.
      allow update: if isOwner(userId)
        && validProfileName(request.resource.data.fullName)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'updatedAt'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'updatedAt'
        ]);

      // Legacy nested documents may remain until existing data is migrated.
      // Clients can only read or remove their own legacy records.
      match /favoriteLocations/{favoriteId} {
        allow read, delete: if isOwner(userId);
      }

      match /navigationSessions/{sessionId} {
        allow read, delete: if isOwner(userId);
      }
    }

    match /favoriteLocations/{favoriteId} {
      allow read, delete: if isOwnerReference(resource.data.userRef);
      allow create: if isOwnerReference(request.resource.data.userRef)
        && validFavorite(request.resource.data);
      allow update: if isOwnerReference(resource.data.userRef)
        && isOwnerReference(request.resource.data.userRef)
        && validFavorite(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'placeName', 'address', 'location', 'createdAt'
        ]);
    }

    match /navigationSessions/{sessionId} {
      allow read: if isOwnerReference(resource.data.userRef);
      allow delete: if isOwnerReference(resource.data.userRef);
      allow create: if isOwnerReference(request.resource.data.userRef)
        && validSession(request.resource.data);
      allow update: if isOwnerReference(resource.data.userRef)
        && isOwnerReference(request.resource.data.userRef)
        && validSession(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'destination', 'endedAt', 'status', 'distance'
        ]);
    }
  }
}
